{
  email {$ACME_EMAIL}
  # 测试期可以用 LE 的 staging，正式发证前注释掉
  # acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# 纯 80 端口健康检查（公网可用性探测）
:80 {
  respond /health "ok" 200
}

# 正式站点（走 443，反代后端）
{$DOMAIN} {
  encode zstd gzip
  reverse_proxy api:8000

  # 强制使用 TLS-ALPN-01（只用 443 验证）
  tls {
    issuer acme {
      disable_http_challenge
    }
  }
}

# 新增：给 lab 这个二级域名做反代
lab.160.16.126.35.sslip.io {
    encode zstd gzip
    # Forward lab API with auth headers
    reverse_proxy lab-api:8001 {
        header_up Host {host}
        header_up X-Api-Key {http.request.header.X-Api-Key}
        header_up Authorization {http.request.header.Authorization}
    }
}
